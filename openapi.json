{
  "components": {
    "schemas": {
      "CanaryStatus": {
        "properties": {
          "at": {
            "format": "date-time",
            "title": "At",
            "type": "string"
          },
          "credits_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Credits Usd"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "at",
          "credits_usd"
        ],
        "title": "CanaryStatus",
        "type": "object"
      },
      "HealthOut": {
        "properties": {
          "canary": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CanaryStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "db": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Db",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "db"
        ],
        "title": "HealthOut",
        "type": "object"
      },
      "VersionOut": {
        "properties": {
          "models": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Models",
            "type": "object"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "models"
        ],
        "title": "VersionOut",
        "type": "object"
      },
      "WorkspaceOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          }
        },
        "required": [
          "created_at"
        ],
        "title": "WorkspaceOut",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "VART",
    "version": "2.0.0.dev0"
  },
