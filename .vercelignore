# Keep the deployed function small: the runtime needs app/ and the sample data (data/dev/docs, data/questionnaires).
.venv
.env*
/docs
tests
evals
scripts
datakit
# The sample path (Plan 3) reads the dev documents and the two bundled questionnaires at runtime.
# (Plan 6A also negates data/csf: the second merger writes the union of both lanes' negations.)
/data/*
!/data/dev
/data/dev/*
!/data/dev/docs
!/data/questionnaires
!/data/NOTICE.md
!/data/LICENSE
.github
.mypy_cache
.ruff_cache
.pytest_cache
.hypothesis
.claude
# `release` deploys the local checkout, not the Git tree: keep the review ledgers and the infra script out of the upload.
.superpowers
ops
migrations
alembic.ini
docker-compose.yml
openapi.json
/public
web/node_modules
web/test-results
web/playwright-report
